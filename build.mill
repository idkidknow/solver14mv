//| mill-version: 1.1.2
//| mvnDeps:
//| - com.goyeau::mill-scalafix::0.6.0

package build
import mill.*, scalalib.*, scalajslib.*, scalajslib.api.*
import mill.api.BuildCtx
import com.goyeau.mill.scalafix.ScalafixModule
import mill.api.Task.Simple

object solver14mv extends ScalaJSModule with ScalafixModule {
  def scalaVersion = "3.7.4"
  def scalaJSVersion = "1.20.2"

  def mvnDeps = Seq(
    mvn"org.scala-js::scalajs-dom::2.8.1",
    mvn"com.raquo::laminar::17.2.1",
    mvn"org.typelevel::cats-effect::3.7.0",
    mvn"co.fs2::fs2-core::3.12.2",
  )

  def scalacOptions = Seq("-Wunused:imports", "-Wall", "-deprecation")

  def moduleKind = ModuleKind.ESModule

  def miniZincSources = Task.Source("src/minizinc")

  def generatedSources = Task {
    val files = os.walk(miniZincSources().path).map(_.last)
    val imports = files
      .map { name =>
        s"""@js.native
         |@JSImport("@scala/minizinc/$name?raw", JSImport.Default)
         |def `$name`: String = js.native
      """.stripMargin
      }
      .mkString("\n")
    val map = files
      .map { name =>
        s"\"\"\"$name\"\"\" -> `$name`,"
      }
      .mkString("\n")
    os.write(
      Task.dest / "MiniZincFiles.scala",
      s"""package solver14mv.solver.minizinc
         |import scala.scalajs.js
         |import scala.scalajs.js.annotation.JSImport
         |object MiniZincFiles {
         |val files: Map[String, String] = Map(
         |$map
         |)
         |$imports
         |}
      """.stripMargin,
    )
    Seq(PathRef(Task.dest))
  }

  def `main-d-ts` = Task.Source("src/solver14mv/main.d.ts")

  def dev() = Task.Command {
    val out = fastLinkJS()
    val dir = out.dest.path
    os.copy.over(dir, Task.dest)
    os.copy(`main-d-ts`().path, Task.dest / "main.d.ts")
    os.copy(miniZincSources().path, Task.dest / "minizinc")
  }
}
