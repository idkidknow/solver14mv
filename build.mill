//| mill-version: 1.1.6
//| mvnDeps:
//| - com.goyeau::mill-scalafix::0.6.0

package build
import mill.*, scalalib.*, scalajslib.*, scalajslib.api.*
import mill.api.BuildCtx
import com.goyeau.mill.scalafix.ScalafixModule
import mill.api.Evaluator
import mainargs.Flag

object solver14mv extends ScalaJSModule with ScalafixModule {
  def scalaVersion = "3.8.3"
  def scalaJSVersion = "1.21.0"

  def mvnDeps = Seq(
    mvn"org.scala-js::scalajs-dom::2.8.1",
    mvn"com.raquo::laminar::17.2.1",
    mvn"org.typelevel::cats-effect::3.7.0",
    mvn"org.typelevel::kittens::3.5.0",
    mvn"co.fs2::fs2-core::3.13.0",
    mvn"com.github.japgolly.scalajs-react::core-bundle-cats_effect::4.0.0",
  )

  def scalacOptions =
    Seq(
      "-Wunused:imports",
      "-Wall",
      "-deprecation",
      "-experimental",
      "-feature",
    )

  def moduleKind = ModuleKind.ESModule

  def miniZincSourceRoot = Task.Source("src/minizinc")
  def mznImports = Task {
    val files = os.walk(miniZincSourceRoot().path).map(_.last)
    val imports = files
      .map { name =>
        s"""@js.native
       |@JSImport("@src/minizinc/$name?raw", JSImport.Default)
       |val `$name`: String = js.native
       |""".stripMargin
      }
      .mkString("\n")
    val map = files
      .map { name =>
        s"\"\"\"$name\"\"\" -> `$name`,"
      }
      .mkString("\n")
    os.write(
      Task.dest / "MiniZincFiles.scala",
      s"""package solver14mv.solver.minizinc
       |import scala.scalajs.js
       |import scala.scalajs.js.annotation.JSImport
       |object MiniZincFiles {
       |val files: Map[String, String] = Map(
       |$map
       |)
       |$imports
       |}
       |""".stripMargin,
    )
    PathRef(Task.dest)
  }

  def cssSourceRoot = Task.Source("src")
  def cssSources = Task {
    val root = cssSourceRoot().path
    val relPaths = os
      .walk(root)
      .filter(_.last.endsWith(".module.css"))
      .map(_.relativeTo(root))
    (root, relPaths)
  }
  def cssModuleImports = Task {
    val (root, relPaths) = cssSources()
    relPaths.foreach { path =>
      val parent = os.RelPath(path.toNIO.getParent)
      val pkg = path.segments.dropRight(1).mkString(".")
      val cls = path.last.replaceAll("""\.module\.css$""", "ModuleCSS")
      val atPath = s"@src/${path.toString}"
      os.write(
        Task.dest / parent / s"$cls.scala",
        s"""package $pkg
           |import scala.scalajs.js
           |import scala.scalajs.js.annotation.JSImport
           |import solver14mv.macros.moduleCSS
           |object $cls {
           |  @js.native
           |  @JSImport("$atPath", JSImport.Default)
           |  @annotation.publicInBinary
           |  protected val obj: js.Object = js.native
           |
           |  inline def as[A]: A = moduleCSS[A]("$atPath", obj)
           |}
           |""".stripMargin,
        createFolders = true,
      )
    }
    PathRef(Task.dest)
  }

  def generatedSources = Task {
    Seq(mznImports(), cssModuleImports())
  }

  def `main-d-ts` = Task.Source("src/solver14mv/main.d.ts")

  def dev = Task {
    val out = fastLinkJS()
    os.copy.over(out.dest.path, Task.dest)
    os.copy(`main-d-ts`().path, Task.dest / "main.d.ts")
    PathRef(Task.dest)
  }
  def prod = Task {
    val out = fullLinkJS()
    os.copy.over(out.dest.path, Task.dest)
    os.copy(`main-d-ts`().path, Task.dest / "main.d.ts")
    PathRef(Task.dest)
  }
}

def build(evaluator: Evaluator, dev: Flag) = Task.Command(exclusive = true) {
  val task = if (dev.value) "solver14mv.dev" else "solver14mv.prod"
  val ret = evaluator.evaluate(Seq(task)).get
  ret.watchable.foreach(BuildCtx.evalWatch0)
  val pathRef = ret.values.get.head.asInstanceOf[PathRef]
  os.copy.over(pathRef.path, Task.dest)
  PathRef(Task.dest)
}
